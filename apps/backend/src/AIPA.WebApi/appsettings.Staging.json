{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "@Microsoft.KeyVault(SecretUri=https://aipa-staging-kv.vault.azure.net/secrets/database-connection-string/)"
  },
  "OpenAI": {
    "ApiKey": "@Microsoft.KeyVault(SecretUri=https://aipa-staging-kv.vault.azure.net/secrets/openai-api-key/)",
    "Model": "gpt-4o-mini",
    "MaxTokens": 3000,
    "Temperature": 0.7,
    "BaseUrl": "https://api.openai.com/v1"
  },
  "Azure": {
    "KeyVault": {
      "Enabled": true,
      "VaultUri": "https://aipa-staging-kv.vault.azure.net/",
      "ClientId": "",
      "TenantId": ""
    },
    "ApplicationInsights": {
      "ConnectionString": "@Microsoft.KeyVault(SecretUri=https://aipa-staging-kv.vault.azure.net/secrets/appinsights-connection-string/)",
      "Enabled": true
    },
    "Speech": {
      "SubscriptionKey": "@Microsoft.KeyVault(SecretUri=https://aipa-staging-kv.vault.azure.net/secrets/azure-speech-key/)",
      "Region": "eastus",
      "Language": "en-US"
    }
  },
  "JWT": {
    "SecretKey": "@Microsoft.KeyVault(SecretUri=https://aipa-staging-kv.vault.azure.net/secrets/jwt-secret-key/)",
    "Issuer": "https://staging-api.aipa.com",
    "Audience": "https://staging.aipa.com",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "CORS": {
    "AllowedOrigins": ["https://staging.aipa.com"],
    "AllowCredentials": true
  },
  "RateLimit": {
    "RequestsPerMinute": 80,
    "BurstSize": 160,
    "Enabled": true
  },
  "FileUpload": {
    "MaxFileSizeMB": 25,
    "AllowedExtensions": [
      ".pdf",
      ".doc",
      ".docx",
      ".txt",
      ".mp3",
      ".wav",
      ".m4a"
    ],
    "StoragePath": "/app/uploads"
  },
  "Security": {
    "EnableSecurityHeaders": true,
    "RequireHttps": true,
    "ContentSecurityPolicy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https:; media-src 'self'; object-src 'none'; frame-ancestors 'none';"
  },
  "Email": {
    "SmtpHost": "@Microsoft.KeyVault(SecretUri=https://aipa-staging-kv.vault.azure.net/secrets/smtp-host/)",
    "SmtpPort": 587,
    "EnableSsl": true,
    "Username": "@Microsoft.KeyVault(SecretUri=https://aipa-staging-kv.vault.azure.net/secrets/smtp-username/)",
    "Password": "@Microsoft.KeyVault(SecretUri=https://aipa-staging-kv.vault.azure.net/secrets/smtp-password/)",
    "FromAddress": "staging@aipa.com",
    "FromName": "AIPA Staging"
  },
  "Cache": {
    "RedisConnectionString": "@Microsoft.KeyVault(SecretUri=https://aipa-staging-kv.vault.azure.net/secrets/redis-connection-string/)",
    "DefaultExpirationMinutes": 45,
    "Enabled": true
  },
  "HealthChecks": {
    "Enabled": true,
    "DatabaseTimeout": 8,
    "ExternalServiceTimeout": 12
  },
  "Monitoring": {
    "EnableMetrics": true,
    "EnableTracing": true,
    "SamplingRate": 0.5
  }
}
