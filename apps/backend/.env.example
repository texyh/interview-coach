# AIPA Backend Environment Variables Template
# Copy this file to .env for local development

# Database Configuration
DATABASE_CONNECTION_STRING=Host=localhost;Database=aipa_dev;Username=aipa_user;Password=YOUR_PASSWORD_HERE

# External Services
OPENAI_API_KEY=your_openai_api_key_here
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_characters_here
JWT_ISSUER=https://api.aipa.local
JWT_AUDIENCE=https://aipa.local
JWT_EXPIRY_MINUTES=60

# Azure Key Vault (Production Only)
AZURE_KEY_VAULT_URL=https://aipa-keyvault.vault.azure.net/
AZURE_CLIENT_ID=your_azure_client_id_here
AZURE_CLIENT_SECRET=your_azure_client_secret_here
AZURE_TENANT_ID=your_azure_tenant_id_here

# Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=your_app_insights_connection_string_here

# Logging Configuration
LOG_LEVEL=Information
ASPNETCORE_ENVIRONMENT=Development

# CORS Configuration
CORS_ORIGINS=https://localhost:3000,https://aipa.local

# Security Headers
ENABLE_SECURITY_HEADERS=true
CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST_SIZE=200

# File Upload Security
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,doc,docx,txt
