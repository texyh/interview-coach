# AIPA AI Service Environment Variables Template
# Copy this file to .env for local development

# Service Configuration
PORT=3001
NODE_ENV=development
SERVICE_NAME=aipa-ai-service
HOST=localhost

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# OpenAI Configuration (Required for AI features)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# Logging Configuration
LOG_LEVEL=info

# Security Configuration (Optional)
# JWT_SECRET=your_jwt_secret_here

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=10

# File Upload Configuration
MAX_FILE_SIZE=52428800

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=3000
DATABASE_SSL=false
DATABASE_POOL_SIZE=10

# AI Services Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7

# Azure Speech Services
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_LANGUAGE=en-US

# Security Configuration
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
CORS_ORIGIN=https://localhost:3000,https://aipa.local
API_KEY_HEADER=x-api-key
API_KEY=your_api_key_for_internal_services_here

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000

# File Processing
MAX_AUDIO_FILE_SIZE_MB=50
SUPPORTED_AUDIO_FORMATS=mp3,wav,m4a,ogg

# Azure Key Vault (Production Only)
AZURE_KEY_VAULT_URL=https://aipa-keyvault.vault.azure.net/
AZURE_CLIENT_ID=your_azure_client_id_here
AZURE_CLIENT_SECRET=your_azure_client_secret_here
AZURE_TENANT_ID=your_azure_tenant_id_here

# Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=your_app_insights_connection_string_here

# External Service URLs
BACKEND_API_URL=https://api.aipa.local
WEB_APP_URL=https://aipa.local

# External Services
BACKEND_API_URL=http://localhost:5000
WEB_APP_URL=http://localhost:3000
