{
  "name": "aipa-angular-app",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "serve:ssr": "node dist/aipa-angular-app/server/server.mjs",
    "generate:api": "npm run generate:backend-api && npm run generate:ai-api",
    "generate:backend-api": "openapi-generator-cli generate -i http://localhost:5030/swagger/v1/swagger.json -g typescript-angular -o src/lib/api/backend  --additional-properties fileNaming=kebab-case,withInterfaces=true --generate-alias-as-model --skip-validate-spec",
    "generate:ai-api": "openapi-generator-cli generate -i http://localhost:3001/api/docs-json -g typescript-angular -o src/lib/api/ai-service  --additional-properties fileNaming=kebab-case,withInterfaces=true --generate-alias-as-model --skip-validate-spec"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.12",
    "@angular/cdk": "^17.3.10",
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@angular/forms": "^17.3.12",
    "@angular/platform-browser": "^17.3.12",
    "@angular/platform-server": "^17.3.12",
    "@angular/router": "^17.3.12",
    "@angular/ssr": "^17.3.8",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "ng-zorro-antd": "^17.4.1",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.3.1",
    "tslib": "^2.3.0",
    "zod": "^4.0.15",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^17.5.2",
    "@angular-eslint/eslint-plugin": "^17.5.2",
    "@angular-eslint/eslint-plugin-template": "^17.5.2",
    "@angular-eslint/schematics": "^17.5.2",
    "@angular-eslint/template-parser": "^17.5.2",
    "@angular/build": "^17.3.8",
    "@angular/cli": "^17.3.8",
    "@angular/compiler-cli": "^17.3.12",
    "@eslint/js": "^9.0.0",
    "@openapitools/openapi-generator-cli": "^2.21.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jasmine": "~5.1.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^18.19.50",
    "angular-eslint": "^17.5.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "husky": "^9.0.0",
    "jasmine-core": "~5.1.2",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.4.5",
    "typescript-eslint": "^7.18.0"
  }
}
