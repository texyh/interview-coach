# Azure DevOps Import Configuration
# Copy this file to .env and update with your actual values

# Azure DevOps Configuration
AZURE_DEVOPS_ORGANIZATION=your-organization-name
AZURE_DEVOPS_PROJECT=your-project-name
AZURE_DEVOPS_PAT_TOKEN=your-personal-access-token

# Optional: Area Path and Iteration Path
AZURE_DEVOPS_AREA_PATH=\\your-project-name
AZURE_DEVOPS_ITERATION_PATH=\\your-project-name\\Sprint 1

# Import Settings
EPICS_DIRECTORY=../stories
CREATE_TASKS=true
LINK_EPICS_TO_FEATURES=false
