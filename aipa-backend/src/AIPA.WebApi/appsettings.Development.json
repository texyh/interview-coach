{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Warning"
      }
    },
    "Properties": {
      "Environment": "Development"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=aipa_dev;Username=admin;Password=Pass@word1;SSL Mode=Prefer;Trust Server Certificate=true"
  },
  "OpenAI": {
    "ApiKey": "sk-dev-key-for-local-development-only",
    "Model": "gpt-4o-mini",
    "MaxTokens": 2000,
    "Temperature": 0.7,
    "BaseUrl": "https://api.openai.com/v1"
  },
  "Azure": {
    "KeyVault": {
      "Enabled": false,
      "VaultUri": "",
      "ClientId": "",
      "TenantId": ""
    },
    "ApplicationInsights": {
      "ConnectionString": "",
      "Enabled": false
    },
    "Speech": {
      "SubscriptionKey": "local-speech-key-placeholder",
      "Region": "eastus",
      "Language": "en-US"
    }
  },
  "JWT": {
    "SecretKey": "local-dev-jwt-secret-key-minimum-32-characters-required-for-security",
    "Issuer": "AIPA",
    "Audience": "AIPA-API",
    "ExpiryInMinutes": 60,
    "RefreshTokenExpiryInDays": 7
  },
  "CORS": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "http://localhost:5173",
      "https://localhost:3000",
      "https://localhost:3001",
      "https://localhost:5173"
    ],
    "AllowCredentials": true
  },
  "RateLimit": {
    "RequestsPerMinute": 100,
    "BurstSize": 200,
    "Enabled": true
  },
  "FileUpload": {
    "MaxFileSizeMB": 10,
    "AllowedExtensions": [
      ".pdf",
      ".doc",
      ".docx",
      ".txt",
      ".mp3",
      ".wav",
      ".m4a"
    ],
    "StoragePath": "./uploads/dev"
  },
  "Security": {
    "EnableSecurityHeaders": true,
    "RequireHttps": false,
    "ContentSecurityPolicy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'"
  },
  "Email": {
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "EnableSsl": false,
    "Username": "",
    "Password": "",
    "FromAddress": "dev@aipa.local",
    "FromName": "AIPA Development"
  },
  "Cache": {
    "RedisConnectionString": "",
    "DefaultExpirationMinutes": 60,
    "Enabled": false
  },
  "HealthChecks": {
    "Enabled": true,
    "DatabaseTimeout": 5,
    "ExternalServiceTimeout": 10
  },
  "AIService": {
    "BaseUrl": "http://localhost:3001",
    "ApiKey": "",
    "TimeoutSeconds": 30,
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 2,
    "EnableFallback": true,
    "EnableCaching": true,
    "CacheExpirationMinutes": 60,
    "HealthCheckEndpoint": "/health",
    "HealthCheckIntervalSeconds": 30,
    "EnableClientGeneration": true
  }
}
